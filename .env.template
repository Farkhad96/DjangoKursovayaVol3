# Django
SECRET_KEY=your-secret-key-min-50-chars
DEBUG=False

# Домен или публичный IP ВМ Yandex Cloud (через запятую)
ALLOWED_HOSTS=your-server-ip,your-domain.com,web

# CORS — адреса фронтенда
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com

# CSRF — домен API (с протоколом)
CSRF_TRUSTED_ORIGINS=http://your-server-ip,https://your-domain.com

# PostgreSQL
POSTGRES_DB=habits
POSTGRES_USER=habits
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- GitHub Actions Secrets (не добавлять в .env на сервере вручную) ---
# SERVER_HOST         — публичный IP ВМ Yandex Cloud
# SERVER_USER         — пользователь SSH (например ubuntu)
# SERVER_PORT         — порт SSH (обычно 22)
# SSH_PRIVATE_KEY     — приватный SSH-ключ для деплоя
# DEPLOY_PATH         — путь к проекту на сервере (/opt/habits-tracker)
